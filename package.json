{
  "name": "replyfold",
  "version": "0.1.0",
  "description": "Open-source support inbox where AI drafts every reply and people approve what goes out.",
  "license": "MIT",
  "author": "Cyndra (https://cyndra.ai)",
  "type": "module",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./src/web/styles.css -o ./src/web/dist.css --minify",
    "dev": "bun run css && bun --hot src/main.ts",
    "start": "bun run css && bun src/main.ts",
    "demo": "bun run css && REPLYFOLD_DEMO=1 bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "sync:coss": "bun scripts/sync-coss.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^2.5.2",
    "lucide-react": "^1.58.0",
    "mailparser": "^3.9.40",
    "nodemailer": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
