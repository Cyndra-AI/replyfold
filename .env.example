# Copy to .env and fill in the values. Never commit .env.

# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/replyfold.sqlite

# Required. Encrypts stored mailbox credentials. Make one with: openssl rand -base64 32
REPLYFOLD_SECRET_KEY=

# Demo mode: made-up mailbox and model, data kept in memory
REPLYFOLD_DEMO=

# Optional. Pick the AI provider in Settings > AI and classification instead.
# A model chosen in Settings takes priority over these values.
# Model: codex, openai, or demo. Leave empty to choose in Settings.
MODEL_PROVIDER=
CODEX_MODEL=
CODEX_BIN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Gmail and Google Workspace (your own Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 and Outlook.com (your own Microsoft Entra app)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# How often to check every mailbox, in seconds (minimum 15)
SYNC_INTERVAL_SECONDS=60

# Turns on the read-only MCP endpoint at /mcp when set
MCP_TOKEN=
